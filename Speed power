local function UpdateSpeed()

	local number =
		tonumber(SpeedBox.Text)

	if not number then
		number = SpeedValue
	end

	number =
		math.clamp(
			number,
			1,
			MAX_SPEED
		)

	SpeedValue = number

	SpeedBox.Text =
		tostring(number)

	local humanoid =
		GetHumanoid()

	if humanoid and SpeedEnabled then

		humanoid.WalkSpeed =
			SpeedValue

	end
end

SpeedBox.FocusLost:Connect(
	UpdateSpeed
)

SpeedButton.MouseButton1Click:Connect(
	function()

		SpeedEnabled =
			not SpeedEnabled

		local humanoid =
			GetHumanoid()

		if humanoid then

			if SpeedEnabled then

				humanoid.WalkSpeed =
					SpeedValue

				SpeedButton.Text =
					"⚡ سرعة: ON"

			else

				humanoid.WalkSpeed =
					16

				SpeedButton.Text =
