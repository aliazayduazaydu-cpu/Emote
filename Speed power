local function SetLine(
	line,
	from,
	to,
	thickness
)

	local difference =
		to - from

	local length =
		difference.Magnitude

	line.Position =
		UDim2.fromOffset(
			(from.X + to.X) / 2,
			(from.Y + to.Y) / 2
		)

	line.Size =
		UDim2.fromOffset(
			length,
			thickness
		)

	line.Rotation =
		math.deg(
			math.atan2(
				difference.Y,
				difference.X
			)
		)
end

