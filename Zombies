		return
	end

	RangePart.Size = Vector3.new(
		FarmRange * 2,
		8,
		FarmRange * 2
	)

	RangePart.CFrame = CFrame.new(Root.Position)

	RangePart.Transparency = AutoFarm and 0.88 or 1
	RangeSelection.Visible = AutoFarm
end)

local function GetEnemyRoot(Model)
	return Model:FindFirstChild("HumanoidRootPart")
		or Model:FindFirstChild("UpperTorso")
		or Model:FindFirstChild("Torso")
		or Model.PrimaryPart
end

local function IsEnemy(Model)
	if not Model:IsA("Model") then
		return false
	end

	local Humanoid = Model:FindFirstChildOfClass("Humanoid")

	if not Humanoid or Humanoid.Health <= 0 then
		return false
	end

	if Players:GetPlayerFromCharacter(Model) then
		return false
	end

	return GetEnemyRoot(Model) ~= nil
end

local function FindTarget()
	local Character = Player.Character

	if not Character then
		return nil
	end

	local Root = Character:FindFirstChild("HumanoidRootPart")

	if not Root then
		return nil
	end

	local Target
	local ClosestDistance = FarmRange

	for _, Object in ipairs(workspace:GetDescendants()) do
		if IsEnemy(Object) then

			local EnemyRoot = GetEnemyRoot(Object)

			if EnemyRoot then
				local Distance =
					(Root.Position - EnemyRoot.Position).Magnitude

				if Distance <= ClosestDistance then
					ClosestDistance = Distance
					Target = Object
				end
			end
		end
	end

	return Target
end

local function GetWeapon()
	local Character = Player.Character

	if not Character then
		return nil
	end

	local Tool = Character:FindFirstChildOfClass("Tool")

	if Tool then
		return Tool
	end

	local Backpack = Player:FindFirstChild("Backpack")

	if not Backpack then
		return nil
	end

	Tool = Backpack:FindFirstChildOfClass("Tool")

	if Tool then
		local Humanoid = Character:FindFirstChildOfClass("Humanoid")

		if Humanoid then
			Humanoid:EquipTool(Tool)
		end

		return Tool
	end

	return nil
end

local function Attack(Target)
	if not Target then
		return
	end

	local Character = Player.Character

	if not Character then
		return
	end

	local Root = Character:FindFirstChild("HumanoidRootPart")
	local EnemyRoot = GetEnemyRoot(Target)
	local EnemyHumanoid = Target:FindFirstChildOfClass("Humanoid")

	if not Root or not EnemyRoot or not EnemyHumanoid then
		return
	end

	if EnemyHumanoid.Health <= 0 then
		return
	end

	local Position =
		EnemyRoot.Position
		- EnemyRoot.CFrame.LookVector * AttackDistance

	Root.CFrame = CFrame.lookAt(
		Position,
		EnemyRoot.Position
	)

	local Weapon = GetWeapon()

	if Weapon then
		pcall(function()
			Weapon:Activate()
		end)
	end
end

task.spawn(function()
	while Gui.Parent do

		if AutoFarm then

			local Target = FindTarget()

			if Target then
				Status.Text = "Target: " .. Target.Name
				Status.TextColor3 = Color3.fromRGB(80, 255, 100)
				Attack(Target)
			else
				Status.Text = "No Enemy In Range"
				Status.TextColor3 = Color3.fromRGB(255, 220, 80)
			end

		else
			Status.Text = "Status: OFF"
			Status.TextColor3 = Color3.fromRGB(255, 80, 80)
		end

		task.wait(AttackDelay)
	end
end)

