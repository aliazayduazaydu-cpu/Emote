--// تتبع اللاعبين
local LastBomb = {}

RunService.Heartbeat:Connect(function()

    local Character = Player.Character
    if not Character then return end

    local Root = Character:FindFirstChild("HumanoidRootPart")
    local Humanoid = Character:FindFirstChildOfClass("Humanoid")

    if not Root or not Humanoid then return end

    Humanoid.WalkSpeed = Speed

    -- حجم المربع
    Box.Size = Vector3.new(
        Range * 2,
        8,
        Range * 2
    )

    Box.CFrame =
        CFrame.new(
            Root.Position + Vector3.new(0,4,0)
        )

    if not Enabled then
        return
    end

    local Target = nil
    local BestDistance = math.huge

    for _,Other in ipairs(Players:GetPlayers()) do

        if Other ~= Player and Other.Character then

            local OtherRoot =
                Other.Character:FindFirstChild("HumanoidRootPart")

            local OtherHumanoid =
                Other.Character:FindFirstChildOfClass("Humanoid")

            if OtherRoot and OtherHumanoid and OtherHumanoid.Health > 0 then

                local Offset =
                    OtherRoot.Position - Root.Position

                local Inside =
                    math.abs(Offset.X) <= Range
                    and math.abs(Offset.Z) <= Range
                    and math.abs(Offset.Y) <= 4

                if Inside then

                    local Distance = Offset.Magnitude

                    if Distance < BestDistance then
                        BestDistance = Distance
                        Target = Other
                    end
                end
            end
        end
    end

    if Target then

        Status.Text =
            "يتتبع: "..Target.Name.." 🎯"

        local Now = os.clock()

        if not LastBomb[Target]
        or Now - LastBomb[Target] > 2 then

            LastBomb[Target] = Now
            Remote:FireServer(Target)
        end

    else

        Status.Text = "لا يوجد لاعب داخل المربع"
    end
end)--// 💣 TIME BOMB SERVER - PART 2
--// ServerScriptService

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local ServerStorage = game:GetService("ServerStorage")

-- إنشاء RemoteEvent تلقائياً
local Remote = ReplicatedStorage:FindFirstChild("TimeBombGive")

if not Remote then
    Remote = Instance.new("RemoteEvent")
    Remote.Name = "TimeBombGive"
    Remote.Parent = ReplicatedStorage
end

local Bomb = ServerStorage:FindFirstChild("TimeBomb")

Remote.OnServerEvent:Connect(function(Player, Target)

    -- التحقق من الهدف
    if typeof(Target) ~= "Instance" then
        return
    end

    if not Target:IsA("Player") then
        return
    end

    if Target == Player then
        return
    end

    -- التحقق من الشخصيات
    local Character = Player.Character
    local TargetCharacter = Target.Character

    if not Character or not TargetCharacter then
        return
    end

    local Root = Character:FindFirstChild("HumanoidRootPart")
    local TargetRoot = TargetCharacter:FindFirstChild("HumanoidRootPart")

    if not Root or not TargetRoot then
        return
    end

    -- حماية السيرفر:
    -- لا يسمح بإعطاء القنبلة إذا كان الهدف بعيداً أكثر من 50
    local Distance = (Root.Position - TargetRoot.Position).Magnitude

    if Distance > 50 then
        return
    end

    -- التأكد من وجود أداة القنبلة
    if not Bomb then
        warn("💣 لم يتم العثور على Tool باسم TimeBomb داخل ServerStorage")
        return
    end

    -- منع إعطاء أكثر من قنبلة موجودة بالفعل
    if Target.Backpack:FindFirstChild("TimeBomb")
    or TargetCharacter:FindFirstChild("TimeBomb") then
        return
    end

    -- إعطاء القنبلة
    local NewBomb = Bomb:Clone()
    NewBomb.Parent = Target.Backpack
end)

