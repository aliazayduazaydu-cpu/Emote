local function StopSpectate()

	Spectating = false

	Spectate.Text =
		"👁️  تجسس"

	local Camera =
		workspace.CurrentCamera

	if Camera and Humanoid then

		Camera.CameraType =
			Enum.CameraType.Custom

		Camera.CameraSubject =
			Humanoid
	end

	Status.Text =
		"👁️ تم إيقاف التجسس"
end

local function StartSpectate()

	if not SelectedPlayer then

		Status.Text =
			"⚠ اختر شخصاً أولاً"

		return
	end

	Spectating = true

	Spectate.Text =
		"👁️  إيقاف التجسس"

	Status.Text =
		"👁️ تجسس: " ..
		SelectedPlayer.DisplayName

	task.spawn(function()

		while Spectating do

			local Camera =
				workspace.CurrentCamera

			local char =
				SelectedPlayer.Character

			local hum =
				char and char:FindFirstChildOfClass(
					"Humanoid"
				)

			if Camera and hum then

				Camera.CameraType =
					Enum.CameraType.Custom

				Camera.CameraSubject =
					hum
			end

			task.wait(0.1)
		end
	end)
end

Spectate.Activated:Connect(function()

	if Spectating then
		StopSpectate()
	else
		StartSpectate()
	end
end)

