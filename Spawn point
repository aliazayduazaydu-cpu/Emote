--==================================================
-- TELEPORT CHECKPOINT
--==================================================

GoCP.Activated:Connect(function()

	if not SelectedCheckPoint then

		Status.Text =
			"⚠ اختر شَك بوينت أولاً"

		Status.TextColor3 =
			Color3.fromRGB(255,170,70)

		return
	end

	local Data =
		CheckPoints[SelectedCheckPoint]

	if not Data or not Data.CFrame then
		return
	end

	if not RootPart then
		return
	end

	RootPart.AssemblyLinearVelocity =
		Vector3.zero

	RootPart.AssemblyAngularVelocity =
		Vector3.zero

	RootPart.CFrame =
		Data.CFrame * CFrame.new(0,3,0)

	Status.Text =
		"🚀 انتقال إلى " .. Data.Name

	Status.TextColor3 =
		Color3.fromRGB(90,200,255)
end)

--==================================================
-- DELETE CHECKPOINT
--==================================================

DeleteCP.Activated:Connect(function()

	if not SelectedCheckPoint then

		Status.Text =
			"⚠ اختر شَك بوينت أولاً"

		return
	end

	local OldIndex =
		SelectedCheckPoint

	local OldName =
		CheckPoints[OldIndex]
		and CheckPoints[OldIndex].Name
		or "شَك بوينت"

	table.remove(
		CheckPoints,
		OldIndex
	)

	if #CheckPoints == 0 then

		SelectedCheckPoint = nil

		SelectedText.Text =
			"📌 المحدد: لا يوجد"

	else

		SelectedCheckPoint =
			math.min(
				OldIndex,
				#CheckPoints
			)

		SelectedText.Text =
			"📌 المحدد: " ..
			CheckPoints[
				SelectedCheckPoint
			].Name
	end

	Status.Text =
		"🗑️ تم حذف " .. OldName

	Status.TextColor3 =
		Color3.fromRGB(255,170,80)

	RefreshCheckPoints()
end)

--==================================================
-- FIND PLAYER
--==================================================

local function FindPlayer(text)

	text = string.lower(text or "")
	text = string.gsub(text,"%s+","")

	if text == "" then
		return nil
	end

	for _,p in ipairs(
		Players:GetPlayers()
	) do

		if p ~= LP then

			if string.lower(p.Name) == text
			or string.lower(p.DisplayName) == text then

				return p
			end
		end
	end

	for _,p in ipairs(
		Players:GetPlayers()
	) do

		if p ~= LP then

			if string.find(
				string.lower(p.Name),
				text,
				1,
				true
			)
			or string.find(
				string.lower(p.DisplayName),
				text,
				1,
				true
			) then

				return p
			end
		end
	end

	return nil
end

