--==================================================
-- OPEN / CLOSE
--==================================================

local function OpenMenu()

	MenuOpen = true
	Main.Visible = true
	MainScale.Scale = 0.75

	TweenService:Create(
		MainScale,
		TweenInfo.new(
			0.25,
			Enum.EasingStyle.Back,
			Enum.EasingDirection.Out
		),
		{Scale = 1}
	):Play()

	TweenService:Create(
		OpenScale,
		TweenInfo.new(0.12),
		{Scale = 0.9}
	):Play()

	task.wait(0.08)

	OpenButton.Text = "×"

	TweenService:Create(
		OpenScale,
		TweenInfo.new(0.12),
		{Scale = 1}
	):Play()
end

local function CloseMenu()

	MenuOpen = false

	TweenService:Create(
		MainScale,
		TweenInfo.new(0.15),
		{Scale = 0.75}
	):Play()

	task.wait(0.12)

	Main.Visible = false
	OpenButton.Text = "+"
end

OpenButton.Activated:Connect(function()

	if MenuOpen then
		CloseMenu()
	else
		OpenMenu()
	end
end)

CloseButton.Activated:Connect(function()

	if MenuOpen then
		CloseMenu()
	end
end)

