RunService.RenderStepped:Connect(function(Delta)

	RainbowTime += Delta * 0.35

	local Color1 = Color3.fromHSV(
		RainbowTime % 1,
		0.9,
		1
	)

	local Color2 = Color3.fromHSV(
		(RainbowTime + 0.35) % 1,
		0.8,
		1
	)

	OpenStroke.Color = Color1
	MainStroke.Color = Color2
	CheckStroke.Color = Color1

	OpenButton.BackgroundColor3 =
		Color3.fromHSV(
			(RainbowTime + 0.5) % 1,
			0.65,
			0.28
		)
end)

