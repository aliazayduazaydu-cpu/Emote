--==================================================
-- ENEMIES
--==================================================

local function EnemyRoot(Model)

	return Model:FindFirstChild("HumanoidRootPart")
		or Model:FindFirstChild("UpperTorso")
		or Model:FindFirstChild("Torso")
		or Model.PrimaryPart

end

local function IsEnemy(Model)

	if not Model:IsA("Model") then
		return false
	end

	local H = Model:FindFirstChildOfClass("Humanoid")

	if not H or H.Health <= 0 then
		return false
	end

	if Players:GetPlayerFromCharacter(Model) then
		return false
	end

	return EnemyRoot(Model) ~= nil
end

local function FindTarget()

	if not Character or not RootPart then
		return nil
	end

	local Target
	local Closest = Data.FarmRange

	for _,Object in ipairs(workspace:GetDescendants()) do

		if IsEnemy(Object) then

			local ER = EnemyRoot(Object)

			if ER then

				local Distance =
					(RootPart.Position - ER.Position).Magnitude

				if Distance <= Closest then
					Closest = Distance
					Target = Object
				end

			end
		end
	end

	return Target
end

--==================================================
-- WEAPON
--==================================================

local function GetWeapon()

	if not Character then
		return nil
	end

	local Tool =
		Character:FindFirstChildOfClass("Tool")

	if Tool then
		return Tool
	end

	local Backpack = Player:FindFirstChild("Backpack")

	if Backpack then

		Tool =
			Backpack:FindFirstChildOfClass("Tool")

		if Tool then

			if Humanoid then

				pcall(function()
					Humanoid:EquipTool(Tool)
				end)

			end

			return Tool
		end
	end

	return nil
end

--==================================================
-- ATTACK
--==================================================

local function Attack(Target)

	if not Target or not RootPart then
		return
	end

	local ER = EnemyRoot(Target)
	local EH = Target:FindFirstChildOfClass("Humanoid")

	if not ER or not EH or EH.Health <= 0 then
		return
	end

	local Above =
		ER.Position +
		Vector3.new(0,Data.HeightAboveZombie,0)

	RootPart.CFrame =
		CFrame.lookAt(Above,ER.Position)

	local Weapon = GetWeapon()

	if Weapon then

		pcall(function()
			Weapon:Activate()
		end)

	end
end

