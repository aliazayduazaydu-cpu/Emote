local function UpdateFarm()

	if Data.AutoFarm then

		FarmToggle.Text = "🌈 AUTO FARM : ON"
		Status.Text = "● Status: ON"
		Status.TextColor3 =
			Color3.fromRGB(80,255,120)

	else

		FarmToggle.Text = "🌈 AUTO FARM : OFF"
		Status.Text = "● Status: OFF"
		Status.TextColor3 =
			Color3.fromRGB(255,80,80)

	end
end

FarmToggle.Activated:Connect(function()

	Data.AutoFarm = not Data.AutoFarm

	UpdateFarm()

end)

--==================================================
-- FARM LOOP
--==================================================

task.spawn(function()

	while Gui.Parent do

		if Data.AutoFarm then

			local Target = FindTarget()

			if Target then

				Status.Text =
					"🎯 Target: "..Target.Name

				local TH =
					Target:FindFirstChildOfClass("Humanoid")

				if TH then

					repeat

						if not Data.AutoFarm then
							break
						end

						if not TH.Parent
							or TH.Health <= 0 then
							break
						end

						Attack(Target)

						task.wait(Data.AttackDelay)

					until not Data.AutoFarm

				end

			else

				Status.Text = "● No Zombie"

				task.wait(0.25)

			end

		else

			task.wait(0.1)

		end

	end

end)

