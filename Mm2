--==================================================
-- ROLE
--==================================================

local function GetRole(player)

    local character = player.Character

    if character then
        if character:FindFirstChild("Knife") then
            return "Murder"
        end

        if character:FindFirstChild("Gun") then
            return "Sheriff"
        end
    end

    local backpack = player:FindFirstChild("Backpack")

    if backpack then
        if backpack:FindFirstChild("Knife") then
            return "Murder"
        end

        if backpack:FindFirstChild("Gun") then
            return "Sheriff"
        end
    end

    return "Innocent"
end

local function RoleColor(role)

    if role == "Murder" then
        return MurderColor
    elseif role == "Sheriff" then
        return SheriffColor
    end

    return InnocentColor
end

--==================================================
-- PLAYER ESP
--==================================================

local function RemoveESP(player)

    if not ESPObjects[player] then
        return
    end

    for _, object in ipairs(ESPObjects[player]) do
        if object and object.Parent then
            object:Destroy()
        end
    end

    ESPObjects[player] = nil
end

local function CreateESP(player)

    if player == LocalPlayer then
        return
    end

    local character = player.Character

    if not character then
        return
    end

    local head = character:FindFirstChild("Head")

    if not head then
        return
    end

    RemoveESP(player)

    local role = GetRole(player)
    local color = RoleColor(role)

    local highlight = Instance.new("Highlight")
    highlight.Name = "RoleESP"
    highlight.Adornee = character
    highlight.FillColor = color
    highlight.OutlineColor = color
    highlight.FillTransparency = 0.55
    highlight.OutlineTransparency = 0
    highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
    highlight.Parent = character

    local nameGui = Instance.new("BillboardGui")
    nameGui.Name = "SmallName"
    nameGui.Adornee = head
    nameGui.Size = UDim2.new(0,100,0,24)
    nameGui.StudsOffset = Vector3.new(0,2.6,0)
    nameGui.AlwaysOnTop = true
    nameGui.Parent = character

    local nameLabel = Instance.new("TextLabel")
    nameLabel.BackgroundTransparency = 1
    nameLabel.Size = UDim2.fromScale(1,1)
    nameLabel.Text = player.Name
    nameLabel.TextColor3 = color
    nameLabel.TextStrokeColor3 = Color3.new(0,0,0)
    nameLabel.TextStrokeTransparency = 0.15
    nameLabel.TextSize = 12
    nameLabel.Font = Enum.Font.GothamBold
    nameLabel.Parent = nameGui

    ESPObjects[player] = {
        highlight,
        nameGui
    }
end

local function UpdateESP()

    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer then

            if ESPEnabled then
                CreateESP(player)
            else
                RemoveESP(player)
            end

        end
    end
end

--==================================================
-- FIND GUN
--==================================================

local function FindGun()

    for _, object in ipairs(workspace:GetDescendants()) do

        if object:IsA("Tool") then

            if object.Name:lower():find("gun") then
                return object
            end

        end

        if object.Name == "GunDrop"
        or object.Name == "Gun" then

            if object:IsA("BasePart")
            or object:IsA("Model") then

                return object
            end
        end
    end

    return nil
end

--==================================================
-- CHECK PICKUP
--==================================================

local function IsPickupGun(gun)

    if not gun then
        return false
    end

    if gun:IsA("Tool") then
        return gun.Enabled ~= false
    end

    if gun:FindFirstChildOfClass(
        "ProximityPrompt",
        true
    ) then
        return true
    end

    if gun:FindFirstChild(
        "TouchInterest",
        true
    ) then
        return true
    end

    return false
end

--==================================================
-- GUN PART
--==================================================

local function GetGunPart(gun)

    if not gun then
        return nil
    end

    if gun:IsA("BasePart") then
        return gun
    end

    if gun:IsA("Model") then

        return gun.PrimaryPart
            or gun:FindFirstChildWhichIsA(
                "BasePart"
            )
    end

    if gun:IsA("Tool") then

        return gun:FindFirstChildWhichIsA(
            "BasePart"
        )
    end

    return nil
end

local function GetGunPosition(gun)

    local part = GetGunPart(gun)

    if part then
        return part.Position
    end

    return nil
end

--==================================================
-- GUN ESP REMOVE
--==================================================

local function RemoveGunESP()

    if GunHighlight then
        GunHighlight:Destroy()
        GunHighlight = nil
    end

    if GunBillboard then
        GunBillboard:Destroy()
        GunBillboard = nil
    end
end

--==================================================
-- GUN ESP
--==================================================

local function UpdateGunESP()

    local gun = FindGun()

    if not IsPickupGun(gun) then

        RemoveGunESP()
        CurrentGun = nil

        return
    end

    if gun == CurrentGun then
        return
    end

    RemoveGunESP()

    CurrentGun = gun

    local highlight = Instance.new("Highlight")

    highlight.Name = "PickupGunESP"
    highlight.FillColor = GunColor
    highlight.OutlineColor = GunOutline
    highlight.FillTransparency = 0.10
    highlight.OutlineTransparency = 0
    highlight.DepthMode =
        Enum.HighlightDepthMode.AlwaysOnTop

    highlight.Adornee = gun
    highlight.Parent = gun

    GunHighlight = highlight

    local part = GetGunPart(gun)

    if part then

        local gui = Instance.new("BillboardGui")

        gui.Name = "GunHere"
        gui.Adornee = part
        gui.Size = UDim2.new(0,160,0,45)
        gui.StudsOffset = Vector3.new(0,3.5,0)
        gui.AlwaysOnTop = true
        gui.Parent = gun

        GunBillboard = gui

        local label = Instance.new("TextLabel")

        label.BackgroundTransparency = 1
        label.Size = UDim2.fromScale(1,1)
        label.Text = "🔫 سلاح هنا"
        label.TextColor3 =
            Color3.fromRGB(255,255,0)
        label.TextStrokeColor3 =
            Color3.new(0,0,0)
        label.TextStrokeTransparency = 0
        label.TextSize = 20
        label.Font = Enum.Font.GothamBold
        label.Parent = gui
    end
end

--==================================================
-- FIND MURDER
--==================================================

local function FindMurder()

    for _, player in ipairs(Players:GetPlayers()) do

        if player ~= LocalPlayer
        and GetRole(player) == "Murder" then

            local character = player.Character

            if character then

                local head =
                    character:FindFirstChild("Head")

                local humanoid =
                    character:FindFirstChildOfClass(
                        "Humanoid"
                    )

                if head
                and humanoid
                and humanoid.Health > 0 then

                    return player
                end
            end
        end
    end

    return nil
end

--==================================================
-- FAST SMOOTH AIM MURDER
--==================================================

local function AimAtMurder()

    if not AimEnabled then
        return
    end

    local murder = FindMurder()

    if not murder
    or not murder.Character then
        return
    end

    local head =
        murder.Character:FindFirstChild("Head")

    if not head then
        return
    end

    local currentCFrame =
        Camera.CFrame

    local targetCFrame =
        CFrame.lookAt(
            currentCFrame.Position,
            head.Position
        )

    -- سريع وناعم
    Camera.CFrame =
        currentCFrame:Lerp(
            targetCFrame,
            0.65
        )
end

