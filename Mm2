--==================================================
-- TAKE GUN
--==================================================

GunButton.MouseButton1Click:Connect(function()

    local character =
        LocalPlayer.Character

    local root =
        character
        and character:FindFirstChild(
            "HumanoidRootPart"
        )

    if not root then
        return
    end

    local gun = FindGun()

    if not IsPickupGun(gun) then

        Status.Text =
            "❌ لا يوجد سلاح قابل للأخذ"

        task.delay(1,function()

            Status.Text =
                "🔴 Murder  🔵 Sheriff  🟢 Innocent"

        end)

        return
    end

    local position =
        GetGunPosition(gun)

    if not position then
        return
    end

    local oldCFrame = root.CFrame

    Status.Text =
        "⚡ أخذ السلاح..."

    root.CFrame =
        CFrame.new(
            position + Vector3.new(0,2.5,0)
        )

    task.wait(0.15)

    if root.Parent then
        root.CFrame = oldCFrame
    end

    Status.Text =
        "✅ تم أخذ السلاح"

    task.delay(1,function()

        Status.Text =
            "🔴 Murder  🔵 Sheriff  🟢 Innocent"

    end)
end)

