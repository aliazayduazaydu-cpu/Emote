local function MakePortal(CF,Name)

	local Model = Instance.new("Model")
	Model.Name = Name
	Model.Parent = workspace

	Model:SetAttribute("PortalType","RickPortal")

	--------------------------------------------------
	-- TOUCH AREA
	--------------------------------------------------

	local Touch = Instance.new("Part")
	Touch.Name = "TeleportArea"
	Touch.Size = Vector3.new(1.2,7,5)
	Touch.CFrame = CF
	Touch.Transparency = 1
	Touch.Anchored = true
	Touch.CanCollide = false
	Touch.CanTouch = true
	Touch.CanQuery = false
	Touch.Parent = Model

	--------------------------------------------------
	-- WHITE OUTER
	--------------------------------------------------

	local Outer = Instance.new("Part")
	Outer.Name = "WhiteOuter"
	Outer.Shape = Enum.PartType.Cylinder
	Outer.Size = Vector3.new(.28,7.8,5.5)
	Outer.CFrame = CF*CFrame.Angles(0,math.rad(90),0)
	Outer.Material = Enum.Material.Neon
	Outer.Color = WHITE
	Outer.Anchored = true
	Outer.CanCollide = false
	Outer.CanTouch = false
	Outer.Parent = Model

	--------------------------------------------------
	-- BLACK RING
	--------------------------------------------------

	local Ring = Instance.new("Part")
	Ring.Name = "BlackRing"
	Ring.Shape = Enum.PartType.Cylinder
	Ring.Size = Vector3.new(.32,7.45,5.15)
	Ring.CFrame = CF*CFrame.Angles(0,math.rad(90),0)
	Ring.Material = Enum.Material.SmoothPlastic
	Ring.Color = BLACK
	Ring.Anchored = true
	Ring.CanCollide = false
	Ring.CanTouch = false
	Ring.Parent = Model

	--------------------------------------------------
	-- GREEN RING
	--------------------------------------------------

	local Energy = Instance.new("Part")
	Energy.Name = "GreenEnergy"
	Energy.Shape = Enum.PartType.Cylinder
	Energy.Size = Vector3.new(.35,7.05,4.85)
	Energy.CFrame = CF*CFrame.Angles(0,math.rad(90),0)
	Energy.Material = Enum.Material.Neon
	Energy.Color = GREEN
	Energy.Anchored = true
	Energy.CanCollide = false
	Energy.CanTouch = false
	Energy.Parent = Model

	--------------------------------------------------
	-- DARK CORE
	--------------------------------------------------

	local Core = Instance.new("Part")
	Core.Name = "PortalCore"
	Core.Shape = Enum.PartType.Cylinder
	Core.Size = Vector3.new(.39,6.65,4.5)
	Core.CFrame = CF*CFrame.Angles(0,math.rad(90),0)
	Core.Material = Enum.Material.Neon
	Core.Color = Color3.fromRGB(0,18,4)
	Core.Anchored = true
	Core.CanCollide = false
	Core.CanTouch = false
	Core.Parent = Model

	--------------------------------------------------
	-- FRONT + BACK GLOW
	--------------------------------------------------

	for side = -1,1,2 do

		local Glow = Instance.new("Part")
		Glow.Name = side == 1 and "FrontGlow" or "BackGlow"
		Glow.Shape = Enum.PartType.Cylinder
		Glow.Size = Vector3.new(.08,6.4,4.25)

		Glow.CFrame =
			CF
			*CFrame.Angles(0,math.rad(90),0)
			*CFrame.new(side*.23,0,0)

		Glow.Material = Enum.Material.Neon
		Glow.Color = GREEN
		Glow.Transparency = .45
		Glow.Anchored = true
		Glow.CanCollide = false
		Glow.CanTouch = false
		Glow.Parent = Model

		local Light = Instance.new("PointLight")
		Light.Color = GREEN
		Light.Brightness = 1.5
		Light.Range = 14
		Light.Parent = Glow
	end

	--------------------------------------------------
	-- SWIRL
	--------------------------------------------------

	local Swirl = Instance.new("Folder")
	Swirl.Name = "GreenSwirl"
	Swirl.Parent = Model

	local Points = {}
	local Count = 130

	for i = 1,Count do

		local P = Instance.new("Part")
		P.Shape = Enum.PartType.Ball
		P.Size = Vector3.new(.08,.08,.08)
		P.Material = Enum.Material.Neon
		P.Color = GREEN
		P.Anchored = true
		P.CanCollide = false
		P.CanTouch = false
		P.CanQuery = false
		P.Parent = Swirl

		Points[i] = P
	end

	local Running = true

	task.spawn(function()

		local Rotation = 0

		while Running and Model.Parent do

			Rotation += .07

			for i,P in ipairs(Points) do

				local T = (i-1)/(Count-1)
				local Angle = T*math.pi*18+Rotation
				local Radius = .12+T*2

				local Y = math.sin(Angle)*Radius*.68
				local Z = math.cos(Angle)*Radius

				P.CFrame =
					CF
					*CFrame.Angles(0,math.rad(90),0)
					*CFrame.new(-.3,Y,-Z)
			end

			RunService.RenderStepped:Wait()
		end
	end)

	--------------------------------------------------
	-- PARTICLES
	--------------------------------------------------

	for side = -1,1,2 do

		local Attachment = Instance.new("Attachment")

		Attachment.Position = Vector3.new(side*.28,0,0)
		Attachment.Parent = Core

		local Particle = Instance.new("ParticleEmitter")
		Particle.Texture = "rbxasset://textures/particles/smoke_main.dds"
		Particle.Color = ColorSequence.new(GREEN)
		Particle.LightEmission = 1
		Particle.Rate = 45
		Particle.Lifetime = NumberRange.new(.35,.8)
		Particle.Speed = NumberRange.new(.1,.7)
		Particle.SpreadAngle = Vector2.new(360,360)
		Particle.Size = NumberSequence.new({
			NumberSequenceKeypoint.new(0,.35),
			NumberSequenceKeypoint.new(.5,.18),
			NumberSequenceKeypoint.new(1,0)
		})
		Particle.Parent = Attachment
	end

	Model.Destroying:Connect(function()
		Running = false
	end)

	return Model,Touch
end

--------------------------------------------------
-- TELEPORT
--------------------------------------------------

local function TeleportCharacter(TargetCF)

	local Character = LP.Character
	if not Character then return end

	local Root = Character:FindFirstChild("HumanoidRootPart")
	if not Root then return end

	Locked = true

	Root.AssemblyLinearVelocity = Vector3.zero
	Root.AssemblyAngularVelocity = Vector3.zero

	Root.CFrame =
		TargetCF *
		CFrame.new(0,0,-3)

	task.delay(TeleportCooldown,function()
		Locked = false
	end)
end

local function ConnectPortal(Touch,TargetCF)

	if not Touch then return end

	Touch.Touched:Connect(function(Hit)

		if Locked then return end

		local Character = LP.Character
		if not Character then return end

		if not Hit:IsDescendantOf(Character) then
			return
		end

		TeleportCharacter(TargetCF)
	end)
end

