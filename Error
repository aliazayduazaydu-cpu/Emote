local function RefreshPlayers()

	for _,Child in ipairs(PlayerList:GetChildren()) do
		if Child:IsA("Frame") then
			Child:Destroy()
		end
	end

	for _,Player in ipairs(Players:GetPlayers()) do

		if Player ~= LP then

			local Row = Instance.new("Frame")
			Row.Size = UDim2.new(1,-6,0,55)
			Row.BackgroundColor3 =
				Player == SelectedPlayer
				and Color3.fromRGB(45,100,60)
				or Color3.fromRGB(35,40,38)
			Row.Parent = PlayerList

			Instance.new("UICorner",Row).CornerRadius = UDim.new(0,8)

			local Avatar = Instance.new("ImageLabel")
			Avatar.Size = UDim2.fromOffset(43,43)
			Avatar.Position = UDim2.fromOffset(6,6)
			Avatar.BackgroundTransparency = 1
			Avatar.Parent = Row

			Instance.new("UICorner",Avatar).CornerRadius = UDim.new(1,0)

			task.spawn(function()

				local OK,Image = pcall(function()

					return Players:GetUserThumbnailAsync(
						Player.UserId,
						Enum.ThumbnailType.HeadShot,
						Enum.ThumbnailSize.Size150x150
					)

				end)

				if OK and Avatar.Parent then
					Avatar.Image = Image
				end
			end)

			local Name = Instance.new("TextLabel")
			Name.Size = UDim2.new(1,-60,1,0)
			Name.Position = UDim2.fromOffset(58,0)
			Name.BackgroundTransparency = 1
			Name.Text =
				Player.DisplayName.."  @"..Player.Name
			Name.TextColor3 = WHITE
			Name.TextSize = 11
			Name.Font = Enum.Font.GothamBold
			Name.TextXAlignment = Enum.TextXAlignment.Left
			Name.TextTruncate = Enum.TextTruncate.AtEnd
			Name.Parent = Row

			local Select = Instance.new("TextButton")
			Select.Size = UDim2.new(1,0,1,0)
			Select.BackgroundTransparency = 1
			Select.Text = ""
			Select.Parent = Row

			Select.Activated:Connect(function()

				SelectedPlayer = Player

				PlayerInfo.Text =
					"✅ اللاعب: "..Player.DisplayName

				RefreshPlayers()
			end)
		end
	end
end

