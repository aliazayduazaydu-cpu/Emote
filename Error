PlacePair.Activated:Connect(function()

	if Placing then return end

	Placing = true
	PlacementMode = "A"

	Status.Text = "🌀 اضغط مكان البوابة الأولى"

	local Connection

	Connection = UIS.InputBegan:Connect(function(Input,Processed)

		if Processed then return end

		if Input.UserInputType ~= Enum.UserInputType.Touch
		and Input.UserInputType ~= Enum.UserInputType.MouseButton1 then
			return
		end

		local CF = GetPosition(Input)
		if not CF then return end

		if PlacementMode == "A" then

			if PortalA then
				PortalA:Destroy()
			end

			local Model = MakePortal(CF,"Portal_A")
			PortalA = Model

			PlacementMode = "B"
			Status.Text = "🌀 الآن اضغط مكان البوابة الثانية"

		elseif PlacementMode == "B" then

			if PortalB then
				PortalB:Destroy()
			end

			local Model = MakePortal(CF,"Portal_B")
			PortalB = Model

			local TouchA =
				PortalA:FindFirstChild("TeleportArea")

			local TouchB =
				PortalB:FindFirstChild("TeleportArea")

			ConnectPortal(
				TouchA,
				PortalB:GetPivot()
			)

			ConnectPortal(
				TouchB,
				PortalA:GetPivot()
			)

			Placing = false
			PlacementMode = nil

			Status.Text = "✅ البوابات مرتبطة"

			Connection:Disconnect()

			task.delay(PortalLifetime,function()

				if PortalA and PortalA.Parent then
					PortalA:Destroy()
					PortalA = nil
				end

				if PortalB and PortalB.Parent then
					PortalB:Destroy()
					PortalB = nil
				end

			end)
		end
	end)
end)

RemovePortals.Activated:Connect(function()

	RemovePortals()

	Status.Text = "🗑 تم حذف البوابات"
end)--------------------------------------------------
