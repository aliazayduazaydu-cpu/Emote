local function RefreshCP()

	for _,Child in ipairs(CPList:GetChildren()) do
		if Child:IsA("Frame") then
			Child:Destroy()
		end
	end

	for _,Data in ipairs(Checkpoints) do

		local Row = Instance.new("Frame")
		Row.Size = UDim2.new(1,-6,0,45)
		Row.BackgroundColor3 =
			Data == SelectedCheckpoint
			and Color3.fromRGB(45,100,60)
			or Color3.fromRGB(35,40,38)
		Row.Parent = CPList

		Instance.new("UICorner",Row).CornerRadius = UDim.new(0,8)

		local Select = Instance.new("TextButton")
		Select.Size = UDim2.new(1,-88,1,0)
		Select.BackgroundTransparency = 1
		Select.Text = "📍 "..Data.Name
		Select.TextColor3 = WHITE
		Select.TextSize = 11
		Select.Font = Enum.Font.GothamBold
		Select.TextXAlignment = Enum.TextXAlignment.Left
		Select.Parent = Row

		Select.Activated:Connect(function()

			SelectedCheckpoint = Data

			Status.Text =
				"📍 "..Data.Name

			RefreshCP()
		end)

		--------------------------------------------------
		-- EDIT BUTTON
		--------------------------------------------------

		local Edit = Instance.new("TextButton")
		Edit.Size = UDim2.fromOffset(38,35)
		Edit.Position = UDim2.new(1,-82,0,5)
		Edit.BackgroundColor3 = GREY
		Edit.Text = "✏️"
		Edit.TextSize = 16
		Edit.Parent = Row

		Instance.new("UICorner",Edit).CornerRadius = UDim.new(0,7)

		Edit.Activated:Connect(function()

			local Input = Instance.new("TextBox")
			Input.Size = UDim2.new(1,-10,0,35)
			Input.Position = UDim2.fromOffset(5,5)
			Input.BackgroundColor3 = Color3.fromRGB(15,18,17)
			Input.TextColor3 = WHITE
			Input.PlaceholderText = "اسم الشكبوينت"
			Input.Text = Data.Name
			Input.TextSize = 11
			Input.Font = Enum.Font.GothamBold
			Input.ClearTextOnFocus = false
			Input.Parent = Row

			Instance.new("UICorner",Input).CornerRadius = UDim.new(0,7)

			Select.Visible = false
			Edit.Visible = false

			Input:CaptureFocus()

			Input.FocusLost:Connect(function()

				local NewName =
					Input.Text:gsub("^%s+",""):gsub("%s+$","")

				if NewName ~= "" then
					Data.Name = NewName
				end

				Input:Destroy()
				Select.Visible = true
				Edit.Visible = true

				RefreshCP()

			end)
		end)

		--------------------------------------------------
		-- DELETE
		--------------------------------------------------

		local Delete = Instance.new("TextButton")
		Delete.Size = UDim2.fromOffset(38,35)
		Delete.Position = UDim2.new(1,-42,0,5)
		Delete.BackgroundColor3 = RED
		Delete.Text = "🗑"
		Delete.TextSize = 14
		Delete.TextColor3 = WHITE
		Delete.Parent = Row

		Instance.new("UICorner",Delete).CornerRadius = UDim.new(0,7)

		Delete.Activated:Connect(function()

			for i,V in ipairs(Checkpoints) do

				if V == Data then

					table.remove(
						Checkpoints,
						i
					)

					break
				end
			end

			if SelectedCheckpoint == Data then
				SelectedCheckpoint = nil
			end

			RefreshCP()
		end)
	end
end

