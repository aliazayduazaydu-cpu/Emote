--==================================================
-- AUTO FARM LOOP
--==================================================

task.spawn(function()

	while Gui.Parent do

		if AutoFarm then

			local Character = Player.Character

			local Humanoid =
				Character and
				Character:FindFirstChildOfClass("Humanoid")

			if not Character
				or not Humanoid
				or Humanoid.Health <= 0 then

				Status.Text =
					"Status: RESPAWNING..."

				-- لا نطفئ AutoFarm هنا
				task.wait(0.3)

			else

				local Target =
					FindTarget()

				if Target then

					local TargetHumanoid =
						Target:FindFirstChildOfClass("Humanoid")

					Status.Text =
						"Target: " .. Target.Name

					Attack(Target)

					if TargetHumanoid then

						repeat

							if not AutoFarm then
								break
							end

							if not TargetHumanoid.Parent then
								break
							end

							if TargetHumanoid.Health <= 0 then
								break
							end

							Attack(Target)

							task.wait(AttackDelay)

						until not AutoFarm

					end

				else

					Status.Text =
						"Status: NO ZOMBIE"

					task.wait(0.25)

				end

			end

		else

			Status.Text =
				"Status: OFF"

			task.wait(0.1)

		end

	end

end)

