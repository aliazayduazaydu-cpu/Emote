--==================================================
-- ENEMY ROOT
--==================================================

local function GetEnemyRoot(Model)

	return Model:FindFirstChild("HumanoidRootPart")
		or Model:FindFirstChild("UpperTorso")
		or Model:FindFirstChild("Torso")
		or Model.PrimaryPart

end

--==================================================
-- ENEMY CHECK
--==================================================

local function IsEnemy(Model)

	if not Model:IsA("Model") then
		return false
	end

	local Humanoid =
		Model:FindFirstChildOfClass("Humanoid")

	if not Humanoid then
		return false
	end

	if Humanoid.Health <= 0 then
		return false
	end

	if Players:GetPlayerFromCharacter(Model) then
		return false
	end

	return GetEnemyRoot(Model) ~= nil

end

--==================================================
-- FIND TARGET
--==================================================

local function FindTarget()

	local Character = Player.Character

	if not Character then
		return nil
	end

	local Root =
		Character:FindFirstChild("HumanoidRootPart")

	if not Root then
		return nil
	end

	local Target = nil
	local ClosestDistance = FarmRange

	for _, Object in ipairs(workspace:GetDescendants()) do

		if IsEnemy(Object) then

			local EnemyRoot =
				GetEnemyRoot(Object)

			if EnemyRoot then

				local Distance =
					(Root.Position - EnemyRoot.Position).Magnitude

				if Distance <= ClosestDistance then

					ClosestDistance = Distance
					Target = Object

				end

			end

		end

	end

	return Target

end

--==================================================
-- GET WEAPON
--==================================================

local function GetWeapon()

	local Character = Player.Character

	if not Character then
		return nil
	end

	local Tool =
		Character:FindFirstChildOfClass("Tool")

	if Tool then
		return Tool
	end

	local Backpack =
		Player:FindFirstChild("Backpack")

	if not Backpack then
		return nil
	end

	Tool =
		Backpack:FindFirstChildOfClass("Tool")

	if Tool then

		local Humanoid =
			Character:FindFirstChildOfClass("Humanoid")

		if Humanoid then

			pcall(function()
				Humanoid:EquipTool(Tool)
			end)

		end

		return Tool

	end

	return nil

end

--==================================================
-- ATTACK + GROUND ORBIT
--==================================================

local function Attack(Target)

	if not Target then
		return
	end

	local Character = Player.Character

	if not Character then
		return
	end

	local Root =
		Character:FindFirstChild("HumanoidRootPart")

	local EnemyRoot =
		GetEnemyRoot(Target)

	local EnemyHumanoid =
		Target:FindFirstChildOfClass("Humanoid")

	if not Root
		or not EnemyRoot
		or not EnemyHumanoid then
		return
	end

	if EnemyHumanoid.Health <= 0 then
		return
	end

	if OrbitEnabled then

		OrbitAngle =
			OrbitAngle +
			math.rad(OrbitSpeed)

		if OrbitAngle > math.pi * 2 then
			OrbitAngle =
				OrbitAngle - math.pi * 2
		end

		local X =
			math.cos(OrbitAngle) * OrbitRadius

		local Z =
			math.sin(OrbitAngle) * OrbitRadius

		local GroundY =
			EnemyRoot.Position.Y

		local OrbitPosition =
			Vector3.new(
				EnemyRoot.Position.X + X,
				GroundY,
				EnemyRoot.Position.Z + Z
			)

		Root.CFrame =
			CFrame.lookAt(
				OrbitPosition,
				Vector3.new(
					EnemyRoot.Position.X,
					GroundY,
					EnemyRoot.Position.Z
				)
			)

	else

		local GroundPosition =
			Vector3.new(
				EnemyRoot.Position.X + OrbitRadius,
				EnemyRoot.Position.Y,
				EnemyRoot.Position.Z
			)

		Root.CFrame =
			CFrame.lookAt(
				GroundPosition,
				Vector3.new(
					EnemyRoot.Position.X,
					EnemyRoot.Position.Y,
					EnemyRoot.Position.Z
				)
			)

	end

	local Weapon = GetWeapon()

	if Weapon then

		pcall(function()
			Weapon:Activate()
		end)

	end

end

