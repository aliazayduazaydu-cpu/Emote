		PlayerList:GetChildren()
	) do

		if Child:IsA("Frame") then
			Child:Destroy()
		end
	end

	for _,P in ipairs(
		Players:GetPlayers()
	) do

		if P ~= LP then

			local Row =
				Instance.new("Frame")

			Row.Size =
				UDim2.new(1,-6,0,55)

			Row.BackgroundColor3 =
				P == SelectedPlayer
				and Color3.fromRGB(45,100,60)
				or Color3.fromRGB(35,40,38)

			Row.Parent =
				PlayerList

			Instance.new(
				"UICorner",
