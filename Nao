-- POSITION
--------------------------------------------------

local function GetPosition(Input)

	local Character = LP.Character
	if not Character then return end

	local Camera = workspace.CurrentCamera
	if not Camera then return end

	local Ray = Camera:ViewportPointToRay(
		Input.Position.X,
		Input.Position.Y
	)

	local Params = RaycastParams.new()

	Params.FilterType =
		Enum.RaycastFilterType.Exclude

	Params.FilterDescendantsInstances =
		{Character}

	local Result =
		workspace:Raycast(
			Ray.Origin,
			Ray.Direction * 1000,
			Params
		)

	if not Result then
		return
	end

	local Hit = Result.Position
	local Normal = Result.Normal

	if math.abs(Normal.Y) > .7 then

		Hit += Vector3.new(0,3.3,0)

		local Look =
			Camera.CFrame.LookVector

		local Dir =
			Vector3.new(
				Look.X,
				0,
				Look.Z
			)

		if Dir.Magnitude < .01 then
			Dir = Vector3.new(0,0,-1)
		end

		return CFrame.lookAt(
			Hit,
			Hit + Dir.Unit,
			Vector3.yAxis
		)
	end

	Hit += Normal * .15

	local Dir =
		-Vector3.new(
			Normal.X,
			0,
			Normal.Z
		)

	if Dir.Magnitude < .01 then
		Dir = Vector3.new(0,0,-1)
	end

	return CFrame.lookAt(
		Hit,
		Hit + Dir.Unit,
		Vector3.yAxis
	)
end--// RICK PORTAL SYSTEM
