--------------------------------------------------
-- TWO PORTALS
--------------------------------------------------

PlacePair.Activated:Connect(function()

	if Placing then return end

	Placing = true
	PlacementMode = "A"

	Status.Text =
		"🌀 اضغط مكان البوابة الأولى"

	local Connection

	Connection =
		UIS.InputBegan:Connect(function(
			Input,
			Processed
		)

		if Processed then
			return
		end

		if Input.UserInputType
			~= Enum.UserInputType.Touch
			and Input.UserInputType
			~= Enum.UserInputType.MouseButton1 then

			return
		end

		local CF =
			GetPosition(Input)

		if not CF then
			Status.Text =
				"❌ لم يتم العثور على مكان"
			return
		end

		--------------------------------------------------
		-- PORTAL A
		--------------------------------------------------

		if PlacementMode == "A" then

			if PortalA then
				PortalA:Destroy()
			end

			local Model =
				MakePortal(
					CF,
					"Portal_A"
				)

			PortalA = Model

			PlacementMode = "B"

			Status.Text =
				"🌀 تم وضع الأولى — اضغط للثانية"

		--------------------------------------------------
		-- PORTAL B
		--------------------------------------------------

		elseif PlacementMode == "B" then

			if PortalB then
				PortalB:Destroy()
			end

			local Model =
				MakePortal(
					CF,
					"Portal_B"
				)

			PortalB = Model

			local TouchA =
				PortalA:FindFirstChild(
					"TeleportArea"
				)

			local TouchB =
				PortalB:FindFirstChild(
					"TeleportArea"
				)

			--------------------------------------------------
			-- IMPORTANT:
			-- نحفظ CFrame كل بوابة قبل الربط
			--------------------------------------------------

			local TargetA = CF
			local TargetB = PortalA:GetPivot()

			ConnectPortal(
				TouchA,
				TargetA
			)

			ConnectPortal(
				TouchB,
				TargetB
			)

			Placing = false
			PlacementMode = nil

			Status.Text =
				"✅ البوابات مرتبطة"

			Connection:Disconnect()

			task.delay(
				PortalLifetime,
				function()

					if PortalA
					and PortalA.Parent then

						PortalA:Destroy()
						PortalA = nil
					end

					if PortalB
					and PortalB.Parent then

						PortalB:Destroy()
						PortalB = nil
					end

					Status.Text =
						"⏱ انتهى وقت البوابات"
				end
			)
		end
	end)
end)

