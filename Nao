local function MakePortal(CF,Name)

	local Model = Instance.new("Model")
	Model.Name = Name
	Model.Parent = workspace

	local Touch = Instance.new("Part")
	Touch.Name = "TeleportArea"
	Touch.Size = Vector3.new(1.1,6.5,4.5)
	Touch.CFrame = CF
	Touch.Transparency = 1
	Touch.Anchored = true
	Touch.CanCollide = false
	Touch.CanTouch = true
	Touch.CanQuery = false
	Touch.Parent = Model

	--------------------------------------------------
	-- FRONT / BACK VISUAL
	--------------------------------------------------

	local function PortalSide(Offset)

		local Side = Instance.new("Model")
		Side.Name = "PortalVisual"
		Side.Parent = Model

		local Outer = Instance.new("Part")
		Outer.Shape = Enum.PartType.Cylinder
		Outer.Size = Vector3.new(.22,7.7,5.45)
		Outer.CFrame =
			CF
			* CFrame.new(Offset,0,0)
			* CFrame.Angles(0,math.rad(90),0)

		Outer.Material = Enum.Material.Neon
		Outer.Color = WHITE
		Outer.Anchored = true
		Outer.CanCollide = false
		Outer.CanTouch = false
		Outer.Parent = Side

		local Ring = Instance.new("Part")
		Ring.Shape = Enum.PartType.Cylinder
		Ring.Size = Vector3.new(.25,7.35,5.1)
		Ring.CFrame =
			CF
			* CFrame.new(Offset + (Offset > 0 and .03 or -.03),0,0)
			* CFrame.Angles(0,math.rad(90),0)

		Ring.Material = Enum.Material.SmoothPlastic
		Ring.Color = BLACK
		Ring.Anchored = true
		Ring.CanCollide = false
		Ring.Parent = Side

		local Energy = Instance.new("Part")
		Energy.Shape = Enum.PartType.Cylinder
		Energy.Size = Vector3.new(.3,6.95,4.75)
		Energy.CFrame =
			CF
			* CFrame.new(Offset + (Offset > 0 and .06 or -.06),0,0)
			* CFrame.Angles(0,math.rad(90),0)

		Energy.Material = Enum.Material.Neon
		Energy.Color = GREEN
		Energy.Transparency = .08
		Energy.Anchored = true
		Energy.CanCollide = false
		Energy.CanTouch = false
		Energy.Parent = Side

		local Core = Instance.new("Part")
		Core.Shape = Enum.PartType.Cylinder
		Core.Size = Vector3.new(.34,6.5,4.35)
		Core.CFrame =
			CF
			* CFrame.new(Offset + (Offset > 0 and .09 or -.09),0,0)
			* CFrame.Angles(0,math.rad(90),0)

		Core.Material = Enum.Material.Neon
		Core.Color = Color3.fromRGB(0,20,5)
		Core.Transparency = .15
		Core.Anchored = true
		Core.CanCollide = false
		Core.CanTouch = false
		Core.Parent = Side

		return Side,Core
	end

	local Front,FrontCore = PortalSide(.08)
	local Back,BackCore = PortalSide(-.08)

	--------------------------------------------------
	-- SWIRL
	--------------------------------------------------

	local Swirl = Instance.new("Folder")
	Swirl.Name = "Swirl"
	Swirl.Parent = Model

	local Points = {}
	local Count = 130

	for i = 1,Count do

		local P = Instance.new("Part")
		P.Shape = Enum.PartType.Ball
		P.Size = Vector3.new(.075,.075,.075)
		P.Material = Enum.Material.Neon
		P.Color = GREEN

		P.Anchored = true
		P.CanCollide = false
		P.CanTouch = false
		P.CanQuery = false

		P.Parent = Swirl
		Points[i] = P
	end

	local Running = true

	task.spawn(function()

		local Rotation = 0

		while Running and Model.Parent do

			Rotation += .065

			for i,P in ipairs(Points) do

				local T = (i-1)/(Count-1)

				local Angle =
					T * math.pi * 22
					+ Rotation

				local Radius =
					.08 + T * 2.05

				local Y =
					math.sin(Angle)
					* Radius
					* .72

				local Z =
					math.cos(Angle)
					* Radius

				P.CFrame =
					CF
					* CFrame.Angles(0,math.rad(90),0)
					* CFrame.new(-.28,Y,-Z)
			end

			RunService.RenderStepped:Wait()
		end
	end)

	--------------------------------------------------
	-- LIGHT
	--------------------------------------------------

	for _,Core in ipairs({FrontCore,BackCore}) do

		local Light = Instance.new("PointLight")
		Light.Color = GREEN
		Light.Brightness = 2.5
		Light.Range = 16
		Light.Parent = Core

	end

	Model.Destroying:Connect(function()
		Running = false
	end)

	return Model,Touch
end

