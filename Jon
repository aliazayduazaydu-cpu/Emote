		if processed then return end

		if input.UserInputType ~= Enum.UserInputType.Touch
		and input.UserInputType ~= Enum.UserInputType.MouseButton1 then
			return
		end

		local startCF = GetPosition(input)
		if not startCF then return end

		--------------------------------------------------
		-- بوابة الانطلاق في المكان الذي اختاره المستخدم
		--------------------------------------------------

		if ReturnPortal then
			ReturnPortal:Destroy()
		end

		local startModel,startTouch =
			MakePortal(startCF,"PlayerTravelPortal")

		--------------------------------------------------
		-- بوابة الوصول خلف اللاعب بقليل
		--------------------------------------------------

		local targetCF =
			targetRoot.CFrame
			*CFrame.new(0,0,4)

		local targetModel,targetTouch =
			MakePortal(
				targetCF,
				"PlayerDestinationPortal"
			)

		ConnectPortal(
			startTouch,
			targetCF
		)

		ConnectPortal(
			targetTouch,
			startCF
		)

		-- هذه هي بوابة الرجوع:
		-- تظهر في المكان الذي وضعت فيه بوابة الانطلاق.
		ReturnPortal = startModel

		Placing = false
		PlacementMode = nil

		Status.Text =
			"✅ البوابة جاهزة — الوصول خلف "..SelectedPlayer.DisplayName

		connection:Disconnect()

		task.delay(PortalLifetime,function()
			if startModel.Parent then
				startModel:Destroy()
			end

			if targetModel.Parent then
				targetModel:Destroy()
			end
		end)
	end)
end)

