local CPPortalButton = MakeButton(
	CPPage,
	"📍 ضع بوابة إلى الشكبوينت",
	305,
	Color3.fromRGB(40,90,125)
)

local function RefreshCP()
	for _,v in ipairs(CPList:GetChildren()) do
		if v:IsA("Frame") then
			v:Destroy()
		end
	end

	for _,data in ipairs(Checkpoints) do

		local row = Instance.new("Frame")
		row.Size = UDim2.new(1,-6,0,43)
		row.BackgroundColor3 =
			data == SelectedCheckpoint
			and Color3.fromRGB(45,100,60)
			or Color3.fromRGB(35,40,38)
		row.Parent = CPList

		Instance.new("UICorner",row).CornerRadius = UDim.new(0,8)

		local select = Instance.new("TextButton")
		select.Size = UDim2.new(1,-45,1,0)
		select.BackgroundTransparency = 1
		select.Text = "📍 "..data.Name
		select.TextColor3 = WHITE
		select.TextSize = 11
		select.Font = Enum.Font.GothamBold
		select.TextXAlignment = Enum.TextXAlignment.Left
		select.Parent = row

		select.Activated:Connect(function()
			SelectedCheckpoint = data
			Status.Text = "📍 "..data.Name
			RefreshCP()
		end)

		local del = Instance.new("TextButton")
		del.Size = UDim2.fromOffset(38,34)
		del.Position = UDim2.new(1,-42,0,4)
		del.BackgroundColor3 = Color3.fromRGB(125,45,45)
		del.Text = "🗑"
		del.TextColor3 = WHITE
		del.Parent = row

		Instance.new("UICorner",del).CornerRadius = UDim.new(0,7)

		del.Activated:Connect(function()
			for i,v in ipairs(Checkpoints) do
				if v == data then
					table.remove(Checkpoints,i)
					break
				end
			end

			if SelectedCheckpoint == data then
				SelectedCheckpoint = nil
			end

			RefreshCP()
		end)
	end
end

AddCP.Activated:Connect(function()
	local char = LP.Character
	local root = char and char:FindFirstChild("HumanoidRootPart")

	if not root then return end

	local data = {
		Name = "Checkpoint "..(#Checkpoints+1),
		CFrame = root.CFrame
	}

	table.insert(Checkpoints,data)
	SelectedCheckpoint = data

	Status.Text = "📍 تم حفظ "..data.Name
	RefreshCP()
end)

