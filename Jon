local function MakePortal(cf,name)
	local Model = Instance.new("Model")
	Model.Name = name
	Model.Parent = workspace

	local Touch = Instance.new("Part")
	Touch.Name = "TeleportArea"
	Touch.Size = Vector3.new(1,7,4.8)
	Touch.CFrame = cf
	Touch.Transparency = 1
	Touch.Anchored = true
	Touch.CanCollide = false
	Touch.CanTouch = true
	Touch.Parent = Model

	local Outer = Instance.new("Part")
	Outer.Name = "WhiteOuter"
	Outer.Shape = Enum.PartType.Cylinder
	Outer.Size = Vector3.new(0.28,7.6,5.4)
	Outer.CFrame = cf*CFrame.Angles(0,math.rad(90),0)
	Outer.Material = Enum.Material.Neon
	Outer.Color = WHITE
	Outer.Anchored = true
	Outer.CanCollide = false
	Outer.Parent = Model

	local Black = Instance.new("Part")
	Black.Name = "BlackRing"
	Black.Shape = Enum.PartType.Cylinder
	Black.Size = Vector3.new(0.30,7.25,5.05)
	Black.CFrame = cf*CFrame.Angles(0,math.rad(90),0)
	Black.Material = Enum.Material.SmoothPlastic
	Black.Color = BLACK
	Black.Anchored = true
	Black.CanCollide = false
	Black.Parent = Model

	local Green = Instance.new("Part")
	Green.Name = "GreenEnergy"
	Green.Shape = Enum.PartType.Cylinder
	Green.Size = Vector3.new(0.34,6.85,4.7)
	Green.CFrame = cf*CFrame.Angles(0,math.rad(90),0)
	Green.Material = Enum.Material.Neon
	Green.Color = GREEN
	Green.Anchored = true
	Green.CanCollide = false
	Green.Parent = Model

	local Center = Instance.new("Part")
	Center.Name = "DarkCenter"
	Center.Shape = Enum.PartType.Cylinder
	Center.Size = Vector3.new(0.37,6.45,4.3)
	Center.CFrame = cf*CFrame.Angles(0,math.rad(90),0)
	Center.Material = Enum.Material.Neon
	Center.Color = Color3.fromRGB(0,20,5)
	Center.Anchored = true
	Center.CanCollide = false
	Center.Parent = Model

	--------------------------------------------------
	-- SWIRL
	--------------------------------------------------

	local Folder = Instance.new("Folder")
	Folder.Name = "GreenSwirl"
	Folder.Parent = Model

	local Points = {}
	local Count = 110

	for i=1,Count do
		local p = Instance.new("Part")
		p.Shape = Enum.PartType.Ball
		p.Size = Vector3.new(.09,.09,.09)
		p.Material = Enum.Material.Neon
		p.Color = GREEN
		p.Anchored = true
		p.CanCollide = false
		p.CanTouch = false
		p.CanQuery = false
		p.Parent = Folder
		Points[i] = p
	end

	local Running = true

	task.spawn(function()
		local rot = 0

		while Running and Model.Parent do
			rot += .07

			for i,p in ipairs(Points) do
				local t = (i-1)/(Count-1)
				local a = t*math.pi*15+rot
				local radius = .08+t*2.0

				local y = math.sin(a)*radius*.7
				local z = math.cos(a)*radius

				p.CFrame =
					cf
					*CFrame.Angles(0,math.rad(90),0)
					*CFrame.new(-.25,y,-z)
			end

			RunService.RenderStepped:Wait()
		end
	end)

	--------------------------------------------------
	-- PARTICLES
	--------------------------------------------------

	local Att = Instance.new("Attachment")
	Att.Parent = Center

	local Particle = Instance.new("ParticleEmitter")
	Particle.Texture = "rbxasset://textures/particles/smoke_main.dds"
	Particle.Color = ColorSequence.new(GREEN)
	Particle.LightEmission = 1
	Particle.Rate = 80
	Particle.Lifetime = NumberRange.new(.3,.7)
	Particle.Speed = NumberRange.new(.1,.5)
	Particle.SpreadAngle = Vector2.new(360,360)
	Particle.Size = NumberSequence.new({
		NumberSequenceKeypoint.new(0,.5),
		NumberSequenceKeypoint.new(.5,.25),
		NumberSequenceKeypoint.new(1,0)
	})
	Particle.Parent = Att

	local Light = Instance.new("PointLight")
	Light.Color = GREEN
	Light.Brightness = 2
	Light.Range = 10
	Light.Parent = Center

	Model.Destroying:Connect(function()
		Running = false
	end)

	return Model,Touch
end

--------------------------------------------------
-- RAYCAST
--------------------------------------------------

local function GetPosition(input)
	local char = LP.Character
	if not char then return end

	local camera = workspace.CurrentCamera
	if not camera then return end

	local ray = camera:ViewportPointToRay(
		input.Position.X,
		input.Position.Y
	)

	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	params.FilterDescendantsInstances = {char}

	local result = workspace:Raycast(
		ray.Origin,
		ray.Direction*1000,
		params
	)

	if not result then return end

	local hit = result.Position
	local normal = result.Normal

	if math.abs(normal.Y) > .7 then
		hit += Vector3.new(0,3.4,0)

		local look = camera.CFrame.LookVector
		local dir = Vector3.new(look.X,0,look.Z)

		if dir.Magnitude < .01 then
			dir = Vector3.new(0,0,-1)
		end

		return CFrame.lookAt(
			hit,
			hit+dir.Unit,
			Vector3.yAxis
		)
	end

	hit += normal*.12

	local dir = -Vector3.new(
		normal.X,
		0,
		normal.Z
	)

	if dir.Magnitude < .01 then
		dir = Vector3.new(0,0,-1)
	end

	return CFrame.lookAt(
		hit,
		hit+dir.Unit,
		Vector3.yAxis
	)
end

