CPPortalButton.Activated:Connect(function()
	if not SelectedCheckpoint then
		Status.Text = "❌ اختر شكبوينت أولاً"
		return
	end

	if Placing then return end

	Placing = true
	PlacementMode = "CHECKPOINT"

	Status.Text =
		"📍 اضغط مكان وضع بوابة الشكبوينت"

	local connection

	connection = UIS.InputBegan:Connect(function(input,processed)
		if processed then return end

		if input.UserInputType ~= Enum.UserInputType.Touch
		and input.UserInputType ~= Enum.UserInputType.MouseButton1 then
			return
		end

		local cf = GetPosition(input)
		if not cf then return end

		local model,touch =
			MakePortal(
				cf,
				"CheckpointPortal"
			)

		ConnectPortal(
			touch,
			SelectedCheckpoint.CFrame
		)

		Placing = false
		PlacementMode = nil

		Status.Text =
			"📍 بوابة "..SelectedCheckpoint.Name.." جاهزة"

		connection:Disconnect()

		task.delay(PortalLifetime,function()
			if model.Parent then
				model:Destroy()
			end
		end)
	end)
end)

