PlacePair.Activated:Connect(function()
	if Placing then return end

	Placing = true
	PlacementMode = "A"
	Status.Text = "🌀 اضغط المكان الذي تريد البوابة الأولى"

	local connection
	connection = UIS.InputBegan:Connect(function(input,processed)
		if processed then return end

		if input.UserInputType ~= Enum.UserInputType.Touch
		and input.UserInputType ~= Enum.UserInputType.MouseButton1 then
			return
		end

		local cf = GetPosition(input)
		if not cf then return end

		if PlacementMode == "A" then
			if PortalA then PortalA:Destroy() end

			local model,touch = MakePortal(cf,"Portal_A")
			PortalA = model

			PlacementMode = "B"
			Status.Text = "🌀 الآن اضغط مكان البوابة الثانية"

		elseif PlacementMode == "B" then
			if PortalB then PortalB:Destroy() end

			local model,touch = MakePortal(cf,"Portal_B")
			PortalB = model

			local touchA = PortalA:FindFirstChild("TeleportArea")
			local touchB = PortalB:FindFirstChild("TeleportArea")

			ConnectPortal(touchA,cf)
			ConnectPortal(touchB,PortalA:GetPivot())

			Placing = false
			PlacementMode = nil
			Status.Text = "✅ البوابتان مرتبطتان"

			connection:Disconnect()

			task.delay(PortalLifetime,function()
				if PortalA == model then
					RemoveNormalPortals()
				end
			end)
		end
	end)
end)

RemovePortals.Activated:Connect(function()
