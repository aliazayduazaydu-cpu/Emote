local function ConnectPortal(touch,target)
	touch.Touched:Connect(function(hit)
		if Locked or not target then return end

		local char = LP.Character
		if not char then return end

		if not hit:IsDescendantOf(char) then return end

		local root = char:FindFirstChild("HumanoidRootPart")
		if not root then return end

		Locked = true

		-- قريب جداً من البوابة الثانية
		root.CFrame =
			target
			*CFrame.new(0,0,-2.5)

		task.delay(TeleportCooldown,function()
			Locked = false
		end)
	end)
end

