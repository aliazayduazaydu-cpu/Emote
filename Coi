	Oval.Parent = Model

	--------------------------------------------------
	-- DARK CENTER
	--------------------------------------------------

	local Center =
		Instance.new("Part")

	Center.Name =
		"PortalCenter"

	Center.Shape =
		Enum.PartType.Cylinder

	Center.Size =
		Vector3.new(
			0.10,
			7.35,
			4.85
		)

	Center.CFrame =
		CF *
		CFrame.Angles(
			0,
			math.rad(90),
			0
		)

	Center.Anchored = true
	Center.CanCollide = false
	Center.CanTouch = false

	Center.Material =
		Enum.Material.Neon

	Center.Color =
		Color3.fromRGB(
			0,
			45,
			8
		)

	Center.Transparency = 0.18

	Center.Parent = Model

	--------------------------------------------------
	-- TWO SIDED DENSE SPIRAL
	--------------------------------------------------

	local Spiral =
		Instance.new("Folder")

	Spiral.Name =
		"TwoSidedSpiral"

	Spiral.Parent = Model

	local FrontPoints = {}
	local BackPoints = {}

	local COUNT = 150

	for I = 1,COUNT do

		local T =
			(I - 1) /
			(COUNT - 1)

		local Angle =
			T *
			math.pi *
			20

		local Radius =
			0.04 +
			T * 2.25

		--------------------------------------------------
		-- FRONT
		--------------------------------------------------

		local Front =
			Instance.new("Part")

		Front.Name =
