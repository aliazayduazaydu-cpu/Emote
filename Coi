local function ConnectPortal(Data)

	local Touch =
		Data.Model:FindFirstChild(
			"PortalTouch"
		)

	if not Touch then
		return
	end

	Touch.Touched:Connect(function(Hit)

		if TeleportLocked then
			return
		end

		if not Data.Linked then
			return
		end

		local Character =
			Player.Character

		if not Character then
			return
		end

		if not Hit:IsDescendantOf(
			Character
		) then
			return
		end

		local Root =
			Character:FindFirstChild(
				"HumanoidRootPart"
			)

		if not Root then
			return
		end

		TeleportLocked = true

		Root.CFrame =
			Data.Linked.CFrame *
			CFrame.new(
				0,
				0,
				-4
			)

		task.delay(
			TELEPORT_COOLDOWN,
			function()
				TeleportLocked = false
			end
		)
	end)
end

