local function StartPortal()

	if Placing then
		return
	end

	Placing = true

	if FirstPortal then

		Status.Text =
			"🌀 اضغط مكان البوابة الثانية"

	else

		Status.Text =
			"🌀 اضغط مكان البوابة الأولى"
	end

	if PlaceConnection then

		PlaceConnection:Disconnect()

	end

	PlaceConnection =
		UIS.InputBegan:Connect(
			function(Input,Processed)

				if Processed then
					return
				end

				if Input.UserInputType ~=
					Enum.UserInputType.Touch
				and Input.UserInputType ~=
					Enum.UserInputType.MouseButton1 then

					return
				end

				if not Placing then
					return
				end

				local CF =
					GetPortalPosition(
						Input
					)

				if not CF then
					return
				end

				Placing = false

				if PlaceConnection then

					PlaceConnection:Disconnect()
					PlaceConnection = nil

				end

				--------------------------------------------------
				-- FIRST
				--------------------------------------------------

				if not FirstPortal then

					local Model =
						CreatePortal(
							"Portal_1",
							CF,
							"🌀 البوابة 1"
						)

					FirstPortal = {

						Model = Model,
						CFrame = CF
					}

					Status.Text =
						"🌀 الأولى جاهزة — ضع الثانية"

					task.delay(
						PORTAL_TIME,
						function()

							if FirstPortal
								and FirstPortal.Model == Model then

								Model:Destroy()

								FirstPortal = nil

								Status.Text =
									"⏱️ انتهت البوابة"
							end
						end
					)

					return
				end

				--------------------------------------------------
				-- SECOND
				--------------------------------------------------

				local Model2 =
					CreatePortal(
						"Portal_2",
						CF,
						"🌀 البوابة 2"
					)

				local A =
					FirstPortal

				local B = {

					Model = Model2,
					CFrame = CF
				}

				A.Linked = B
				B.Linked = A

				local Pair = {

					A = A,
					B = B
				}

				table.insert(
					ActivePairs,
					Pair
				)

				ConnectPortal(A)
				ConnectPortal(B)

				FirstPortal = nil

				Status.Text =
					"🌀 تم الربط — ادخل داخل البوابة"

				task.delay(
					PORTAL_TIME,
					function()

						RemovePair(Pair)

					end
				)
			end
		)
end

