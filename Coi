--------------------------------------------------
-- GIVE GUN
--------------------------------------------------

local function GiveGun()

	local Backpack =
		Player:WaitForChild("Backpack")

	local Found =
		Backpack:FindFirstChild(
			"Rick Portal Gun"
		)

	if Found then
		Tool = Found
		return Found
	end

	if Player.Character then

		Found =
			Player.Character:FindFirstChild(
				"Rick Portal Gun"
			)

		if Found then
			Tool = Found
			return Found
		end
	end

	local NewTool =
		CreateTool()

	Tool = NewTool

	NewTool.Parent =
		Backpack

	return NewTool
end

