local function Refresh()

	for _,V in ipairs(List:GetChildren()) do

		if V:IsA("Frame") then
			V:Destroy()
		end
	end

	for _,Data in ipairs(Checkpoints) do

		local Row =
			Instance.new("Frame")

		Row.Size =
			UDim2.new(
				1,
				-6,
				0,
				34
			)

		Row.BackgroundColor3 =
			Data == SelectedCheckpoint
			and Color3.fromRGB(50,100,60)
			or Color3.fromRGB(45,50,48)

		Row.Parent = List

		local Select =
			Instance.new("TextButton")

		Select.Size =
			UDim2.new(
				1,
				-65,
				1,
				0
			)

		Select.BackgroundTransparency = 1

		Select.Text =
			"📍 "..Data.Name

		Select.TextColor3 =
			Color3.new(1,1,1)

		Select.TextSize = 11

		Select.TextXAlignment =
			Enum.TextXAlignment.Left

		Select.Parent = Row

		Select.MouseButton1Click:Connect(function()

			SelectedCheckpoint = Data

			Status.Text =
				"✅ "..Data.Name

			Refresh()
		end)

		local Edit =
			Instance.new("TextButton")

		Edit.Size =
			UDim2.new(
				0,
				30,
				0,
				28
			)

		Edit.Position =
			UDim2.new(
				1,
				-62,
				0,
				3
			)

		Edit.Text = "✏️"
		Edit.TextSize = 12
		Edit.Parent = Row

		Edit.MouseButton1Click:Connect(function()

			RenameTarget = Data
			NameBox.Text = Data.Name
			Rename.Visible = true
		end)

		local Delete =
			Instance.new("TextButton")

		Delete.Size =
			UDim2.new(
				0,
				30,
				0,
				28
			)

		Delete.Position =
			UDim2.new(
				1,
				-32,
				0,
				3
			)

		Delete.BackgroundColor3 =
			Color3.fromRGB(
				150,
				50,
				50
			)

		Delete.Text = "🗑️"
		Delete.Parent = Row

		Delete.MouseButton1Click:Connect(function()

			for I,V in ipairs(Checkpoints) do

				if V == Data then

					table.remove(
						Checkpoints,
						I
					)

					break
				end
			end

			if SelectedCheckpoint == Data then
				SelectedCheckpoint = nil
			end

			Refresh()

			Status.Text =
				"🗑️ تم حذف الشكبوينت"
		end)
	end

	task.wait()

	List.CanvasSize =
		UDim2.new(
			0,
			0,
			0,
			Layout.AbsoluteContentSize.Y + 6
		)
end

