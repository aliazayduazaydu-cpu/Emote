-- GET EXACT CLICK POSITION
--------------------------------------------------

local function GetPortalPosition(Input)

	local Character =
		Player.Character

	if not Character then
		return nil
	end

	local Camera =
		workspace.CurrentCamera

	if not Camera then
		return nil
	end

	local P =
		Input.Position

	local Ray =
		Camera:ViewportPointToRay(
			P.X,
			P.Y
		)

	local Params =
		RaycastParams.new()

	Params.FilterType =
		Enum.RaycastFilterType.Exclude

	Params.FilterDescendantsInstances = {
		Character
	}

	local Result =
		workspace:Raycast(
			Ray.Origin,
			Ray.Direction * 1000,
			Params
		)

	if not Result then
		return nil
	end

	local Hit =
		Result.Position

	local Normal =
		Result.Normal

	local Position

	--------------------------------------------------
	-- FLOOR
	--------------------------------------------------

	if math.abs(Normal.Y) > 0.7 then

		Position =
			Hit +
			Vector3.new(
				0,
				3.9,
				0
			)

	--------------------------------------------------
	-- WALL
	--------------------------------------------------

	else

		Position =
			Hit +
			Normal * 0.15

	end

	local Direction

	if math.abs(Normal.Y) > 0.7 then

		local Look =
			Camera.CFrame.LookVector

		Direction =
			Vector3.new(
				Look.X,
				0,
				Look.Z
			)

		if Direction.Magnitude < 0.01 then

			Direction =
				Vector3.new(
					0,
					0,
					-1
				)
		end

		Direction =
			Direction.Unit

	else

		Direction =
			-Vector3.new(
				Normal.X,
				0,
				Normal.Z
			)

		if Direction.Magnitude < 0.01 then

			Direction =
				Vector3.new(
					0,
					0,
					-1
				)
		end

		Direction =
			Direction.Unit
	end

	return CFrame.lookAt(
		Position,
		Position + Direction,
		Vector3.new(0,1,0)
	)
end

