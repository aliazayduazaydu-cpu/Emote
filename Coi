local function RemovePair(Pair)

	if Pair.A
		and Pair.A.Model
		and Pair.A.Model.Parent then

		Pair.A.Model:Destroy()
	end

	if Pair.B
		and Pair.B.Model
		and Pair.B.Model.Parent then

		Pair.B.Model:Destroy()
	end

	for I,V in ipairs(ActivePairs) do

		if V == Pair then

			table.remove(
				ActivePairs,
				I
			)

			break
		end
	end
end

