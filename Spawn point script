local function StopSpectate()

	Spectating = false

	SpectateButton.Text =
		"👁️  تجسس"

	local Camera =
		workspace.CurrentCamera

	-- إرجاع الكاميرا لشخصيتك
	if Camera and MyHumanoid then

		Camera.CameraType =
			Enum.CameraType.Custom

		Camera.CameraSubject =
			MyHumanoid

	elseif Camera and Character then

		local Hum =
			Character:FindFirstChildOfClass(
				"Humanoid"
			)

		if Hum then

			MyHumanoid = Hum

			Camera.CameraType =
				Enum.CameraType.Custom

			Camera.CameraSubject =
				Hum
		end
	end

	Status.Text =
		"👁️  تم إيقاف التجسس"

	Status.TextColor3 =
		Color3.fromRGB(
			160,160,175
		)
end

local function StartSpectate()

	if not SelectedPlayer then

		Status.Text =
			"⚠  اختر شخصاً أولاً"

		Status.TextColor3 =
			Color3.fromRGB(
