--==================================================
-- OPEN / CLOSE
--==================================================

local function OpenMenu()

	MenuOpen = true

	Main.Visible = true

	MainScale.Scale = 0.75

	RefreshPlayers()

	TweenService:Create(
		MainScale,
		TweenInfo.new(
			0.25,
			Enum.EasingStyle.Back,
			Enum.EasingDirection.Out
		),
		{
			Scale = 1
		}
	):Play()

	OpenButton.Text = "×"
end

local function CloseMenu()

	MenuOpen = false

	TweenService:Create(
		MainScale,
		TweenInfo.new(0.14),
		{
			Scale = 0.75
		}
	):Play()

	task.wait(0.12)

	Main.Visible = false

	OpenButton.Text = "+"
end

OpenButton.Activated:Connect(function()

	if MenuOpen then

		CloseMenu()

	else

		OpenMenu()
	end
end)

Close.Activated:Connect(function()

	if MenuOpen then
		CloseMenu()
	end
end)

