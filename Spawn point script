	PreviewUser.Text =
		"@" .. Target.Name

	SelectedLabel.Text =
		"المحدد: " .. Target.DisplayName

	SelectedLabel.TextColor3 =
		Color3.fromRGB(90,200,255)

	Search.Text =
		Target.Name

	task.spawn(function()

		local Success,Image =
			pcall(function()

				return Players:GetUserThumbnailAsync(
					Target.UserId,
					Enum.ThumbnailType.HeadShot,
					Enum.ThumbnailSize.Size150x150
				)

			end)

		if Success and Image then
			Avatar.Image = Image
		end
	end)
end

--==================================================
-- FIND PLAYER
--==================================================

local function FindPlayer(Text)

	Text = string.lower(Text or "")

	Text = string.gsub(
		Text,
		"^%s+",
		""
	)

	Text = string.gsub(
		Text,
		"%s+$",
		""
	)

	if Text == "" then
		return nil
	end

	for _,P in ipairs(
		Players:GetPlayers()
	) do

		if P ~= LP then

			if string.lower(P.Name) == Text
			or string.lower(P.DisplayName) == Text then

				return P
			end
		end
	end

	for _,P in ipairs(
		Players:GetPlayers()
	) do

		if P ~= LP then

			if string.sub(
				string.lower(P.Name),
				1,
				#Text
			) == Text

			or string.sub(
				string.lower(P.DisplayName),
				1,
				#Text
			) == Text then

				return P
			end
		end
	end

	return nil
end

