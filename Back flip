local zeezy = Players.LocalPlayer

local h = 0.0174533

--==================================================
-- KEYS
--==================================================

local FrontflipKey = Enum.KeyCode.Z
local BackflipKey = Enum.KeyCode.X
local AirjumpKey = Enum.KeyCode.C
local ExtraFrontflipKey = Enum.KeyCode.F

--==================================================
-- CHARACTER
--==================================================

local function getCharacter()
	return zeezy.Character or zeezy.CharacterAdded:Wait()
end

local function getHumanoid()
	local character = getCharacter()
	return character:FindFirstChildOfClass("Humanoid")
end

local function getRoot()
	local character = getCharacter()
	return character:FindFirstChild("HumanoidRootPart")
end

--==================================================
-- FRONT FLIP
--==================================================

local function zeezyFrontflip(act, inp, obj)

	if inp ~= Enum.UserInputState.Begin then
		return
	end

	local humanoid = getHumanoid()
	local root = getRoot()

	if not humanoid or not root then
		return
	end

	humanoid:ChangeState(Enum.HumanoidStateType.Jumping)

	task.wait()

	if not humanoid.Parent or not root.Parent then
		return
	end

	humanoid.Sit = true

	for i = 1, 360 do

		task.delay(i / 720, function()

			if root.Parent and humanoid.Parent then

				humanoid.Sit = true

				root.CFrame =
					root.CFrame *
					CFrame.Angles(-h, 0, 0)

			end

		end)

	end

	task.wait(0.55)

	if humanoid.Parent then
		humanoid.Sit = false
	end
end

--==================================================
-- BACK FLIP
--==================================================

local function zeezyBackflip(act, inp, obj)

	if inp ~= Enum.UserInputState.Begin then
		return
	end

	local humanoid = getHumanoid()
	local root = getRoot()

	if not humanoid or not root then
		return
	end

	humanoid:ChangeState(Enum.HumanoidStateType.Jumping)

	task.wait()

	if not humanoid.Parent or not root.Parent then
		return
	end

	humanoid.Sit = true

	for i = 1, 360 do

		task.delay(i / 720, function()

			if root.Parent and humanoid.Parent then

				humanoid.Sit = true

				root.CFrame =
					root.CFrame *
					CFrame.Angles(h, 0, 0)

			end

		end)

	end

	task.wait(0.55)

	if humanoid.Parent then
		humanoid.Sit = false
	end
end

--==================================================
-- AIR JUMP
--==================================================

local function zeezyAirjump(act, inp, obj)

	if inp ~= Enum.UserInputState.Begin then
		return
	end

	local humanoid = getHumanoid()

	if not humanoid then
		return
	end

	humanoid:ChangeState(Enum.HumanoidStateType.Seated)

	task.wait()

	if humanoid.Parent then
		humanoid:ChangeState(Enum.HumanoidStateType.Jumping)
	end
end

