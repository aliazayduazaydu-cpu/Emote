local LastGun

local function GunESP()

	local gun = FindGun()

	if gun == LastGun then
		return
	end

	LastGun = gun

	if not gun then
		return
	end

	local highlight = Instance.new("Highlight")

	highlight.Name = "GunESP"
	highlight.Adornee = gun

	highlight.FillColor =
		Color3.fromRGB(255,255,0)

	highlight.OutlineColor =
		Color3.fromRGB(255,150,0)

	highlight.FillTransparency = .05
	highlight.DepthMode =
		Enum.HighlightDepthMode.AlwaysOnTop

	highlight.Parent = gun

	local part = GunPart(gun)

	if part then

		local label = Instance.new("BillboardGui")

		label.Name = "GunText"
		label.Adornee = part
		label.Size = UDim2.new(0,140,0,30)
		label.StudsOffset = Vector3.new(0,3,0)
		label.AlwaysOnTop = true
		label.Parent = gun

		local text = Instance.new("TextLabel")

		text.Size = UDim2.fromScale(1,1)
		text.BackgroundTransparency = 1
		text.Text = "🔫 سلاح هنا"
		text.TextColor3 = Color3.fromRGB(255,255,0)
		text.TextStrokeTransparency = 0
		text.TextSize = 16
		text.Font = Enum.Font.GothamBold
		text.Parent = label
	end
end

--==================================================
-- TAKE GUN
--==================================================

GunBtn.MouseButton1Click:Connect(function()

	local character = LP.Character
	local root =
		character
		and character:FindFirstChild("HumanoidRootPart")

	local gun = FindGun()
	local part = GunPart(gun)

	if not root or not part then

		Status.Text = "❌ لا يوجد سلاح"

		task.delay(1,function()
			Status.Text =
				"🔴 Murder   🔵 Sheriff   🟢 Innocent"
		end)

		return
	end

	local oldPosition = root.CFrame

	Status.Text = "⚡ الانتقال للسلاح..."

	root.CFrame =
		CFrame.new(
			part.Position + Vector3.new(0,2,0)
		)

	task.wait(.15)

	if root.Parent then
		root.CFrame = oldPosition
	end

	Status.Text = "✅ تم أخذ السلاح"

	task.delay(1,function()

		Status.Text =
			"🔴 Murder   🔵 Sheriff   🟢 Innocent"

	end)
end)

