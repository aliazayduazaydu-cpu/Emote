local function Rainbow(obj)
	task.spawn(function()
		local hue = 0

		while obj and obj.Parent do
			hue = (hue + 0.008) % 1
			obj.BackgroundColor3 = Color3.fromHSV(hue,0.85,1)
			task.wait()
		end
	end)
end

