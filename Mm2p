--==================================================
-- DRAG
--==================================================

local function MakeDraggable(obj)

	local dragging = false
	local startInput
	local startPosition

	obj.InputBegan:Connect(function(input)

		if input.UserInputType == Enum.UserInputType.Touch
		or input.UserInputType == Enum.UserInputType.MouseButton1 then

			dragging = true
			startInput = input.Position
			startPosition = obj.Position
		end
	end)

	UIS.InputChanged:Connect(function(input)

		if not dragging then return end

		if input.UserInputType == Enum.UserInputType.Touch
		or input.UserInputType == Enum.UserInputType.MouseMovement then

			local delta = input.Position - startInput

			obj.Position = UDim2.new(
				startPosition.X.Scale,
				startPosition.X.Offset + delta.X,
				startPosition.Y.Scale,
				startPosition.Y.Offset + delta.Y
			)
		end
	end)

	UIS.InputEnded:Connect(function(input)

		if input.UserInputType == Enum.UserInputType.Touch
		or input.UserInputType == Enum.UserInputType.MouseButton1 then

			dragging = false
		end
	end)
end

MakeDraggable(Main)
MakeDraggable(Open)

--==================================================
-- ROLE DETECTION
--==================================================

local Colors = {
	Murder = Color3.fromRGB(255,40,40),
	Sheriff = Color3.fromRGB(40,120,255),
	Innocent = Color3.fromRGB(40,255,70)
}

local function Role(p)

	local c = p.Character
	local b = p:FindFirstChild("Backpack")

	if c and c:FindFirstChild("Knife")
	or b and b:FindFirstChild("Knife") then
		return "Murder"
	end

	if c and c:FindFirstChild("Gun")
	or b and b:FindFirstChild("Gun") then
		return "Sheriff"
	end

	return "Innocent"
end

--==================================================
-- ESP
--==================================================

local function ClearESP(p)

	if not p.Character then return end

	for _,v in ipairs(p.Character:GetChildren()) do

		if v.Name == "MM2ESP"
		or v.Name == "MM2Name" then

			v:Destroy()
		end
	end
end

local function MakeESP(p)

	if p == LP or not p.Character then return end

	local c = p.Character
	local head = c:FindFirstChild("Head")

	if not head then return end

	ClearESP(p)

	local color = Colors[Role(p)]

	local h = Instance.new("Highlight")

	h.Name = "MM2ESP"
	h.Adornee = c
	h.FillColor = color
	h.OutlineColor = color
	h.FillTransparency = .55
	h.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
	h.Parent = c

	local g = Instance.new("BillboardGui")

	g.Name = "MM2Name"
	g.Adornee = head
	g.Size = UDim2.new(0,90,0,20)
	g.StudsOffset = Vector3.new(0,2.5,0)
	g.AlwaysOnTop = true
	g.Parent = c

	local t = Instance.new("TextLabel")

	t.Size = UDim2.fromScale(1,1)
	t.BackgroundTransparency = 1
	t.Text = p.Name
	t.TextColor3 = color
	t.TextStrokeTransparency = 0
	t.TextSize = 10
	t.Font = Enum.Font.GothamBold
	t.Parent = g
end

local function UpdateESP()

	for _,p in ipairs(Players:GetPlayers()) do

		if p ~= LP then

			if ESP then
				MakeESP(p)
			else
				ClearESP(p)
			end
		end
	end
end

