--==================================================
-- FIND MURDER
--==================================================

local function FindMurder()

	for _,p in ipairs(Players:GetPlayers()) do

		if p ~= LP and Role(p) == "Murder" then

			local c = p.Character
			local head = c and c:FindFirstChild("Head")
			local hum = c and c:FindFirstChildOfClass("Humanoid")

			if head and hum and hum.Health > 0 then
				return p
			end
		end
	end
end

--==================================================
-- AIM MURDER
--==================================================

RS.RenderStepped:Connect(function()

	if not Aim then return end

	local p = FindMurder()

	if not p or not p.Character then
		return
	end

	local head = p.Character:FindFirstChild("Head")

	if head then

		local cf = Cam.CFrame

		Cam.CFrame = cf:Lerp(
			CFrame.lookAt(
				cf.Position,
				head.Position
			),
			.75
		)
	end
end)

--==================================================
-- FIND GUN
--==================================================

local function FindGun()

	for _,v in ipairs(workspace:GetDescendants()) do

		if v.Name == "GunDrop"
		or v.Name == "Gun" then

			if v:IsA("BasePart")
			or v:IsA("Model") then

				return v
			end
		end

		if v:IsA("Tool")
		and v.Name:lower():find("gun") then

			return v
		end
	end
end

local function GunPart(g)

	if not g then return end

	if g:IsA("BasePart") then
		return g
	end

	if g:IsA("Model") then

		return g.PrimaryPart
		or g:FindFirstChildWhichIsA("BasePart")
	end

	if g:IsA("Tool") then

		return g:FindFirstChildWhichIsA("BasePart")
	end
end

