-- FIND MURDER
--==================================================

local function FindMurder()

	for _,Player in ipairs(
		Players:GetPlayers()
	) do

		if Player ~= LP
		and GetRole(Player) == "Murder" then

			local Character =
				Player.Character

			local Head =
				Character
				and Character:FindFirstChild("Head")

			local Humanoid =
				Character
				and Character:FindFirstChildOfClass(
					"Humanoid"
				)

			if Head
			and Humanoid
			and Humanoid.Health > 0 then

				return Player
			end
		end
	end
end

