local RoleColors = {

	Murder =
		Color3.fromRGB(255,40,40),

	Sheriff =
		Color3.fromRGB(40,120,255),

	Innocent =
		Color3.fromRGB(40,255,70)
}

local function GetRole(Player)

	local Character =
		Player.Character

	local Backpack =
		Player:FindFirstChild("Backpack")

	if Character and
		Character:FindFirstChild("Knife")

	or Backpack and
		Backpack:FindFirstChild("Knife") then

		return "Murder"
	end

	if Character and
		Character:FindFirstChild("Gun")

	or Backpack and
		Backpack:FindFirstChild("Gun") then

		return "Sheriff"
	end

	return "Innocent"
end

