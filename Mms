-- المسدس
--==================================================

local function FindGun()

	for _,Object in ipairs(
		workspace:GetDescendants()
	) do

		if Object.Name == "GunDrop" then
			return Object
		end
	end

	return nil
end

local function GetGunPart(Gun)

	if not Gun then
		return nil
	end

	if Gun:IsA("BasePart") then
		return Gun
	end

	if Gun:IsA("Model") then

		return Gun.PrimaryPart
			or Gun:FindFirstChildWhichIsA(
				"BasePart"
			)
	end

	return nil
end

--==================================================
-- زر كشف المسدس
--==================================================

GunBtn.MouseButton1Click:Connect(function()

	local Gun =
		FindGun()

	local Part =
		GetGunPart(Gun)

	if not Part then

		Status.Text =
			"❌ المسدس غير موجود"

		return
	end

	local Character =
		LP.Character

	local Root =
		Character
		and Character:FindFirstChild(
			"HumanoidRootPart"
		)

	if not Root then
		return
	end

	-- تمييز المسدس
	local Highlight =
		Gun:FindFirstChild("GunHighlight")

	if not Highlight then

		Highlight =
			Instance.new("Highlight")

		Highlight.Name =
			"GunHighlight"

		Highlight.Adornee =
			Gun

		Highlight.FillColor =
			Color3.fromRGB(
				255,255,0
			)

		Highlight.OutlineColor =
			Color3.fromRGB(
				255,150,0
			)

		Highlight.DepthMode =
			Enum.HighlightDepthMode.AlwaysOnTop

		Highlight.Parent = Gun
	end

	Status.Text =
		"🔫 تم تحديد مكان المسدس"

end)

